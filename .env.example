# The Bold Life Coach — live backends. Copy to .env, fill in, then `npm run build:web`.
# Everything runs on our own infrastructure (Supabase + our Edge Functions); the
# model and email transport are reached only through those functions, never a
# third-party assistant or marketing SaaS the client sees.

# Supabase project — powers live-class signaling (Realtime) and hosts the functions.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key from Project Settings → API>

# Edge Functions (deploy with supabase/deploy-functions.sh, then paste the URLs it prints).
VITE_AGENT_URL=https://<project-ref>.supabase.co/functions/v1/agent
VITE_EMAIL_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/send-email

# Payments (optional, for the Enroll screen).
VITE_STRIPE_PUBLISHABLE_KEY=
